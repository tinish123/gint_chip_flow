def widened_shielded_routes(tool: HammerTool) -> bool:
    if tool.top_module == "GINT1AChipletTop":
        nets_require_shield = "ref0 ref1 ref2 ext0 extA extB".split()
        for net in nets_require_shield:
            tool.append(f"set_route_attributes -nets {net} -shield_nets \"VDD VSS\" -bottom_preferred_routing_layer 5 -top_preferred_routing_layer 6")
        tool.append("create_route_type -name shielded_clock_route_type -shield_net VSS")
        tool.append("set_db cts_route_type_top shielded_clock_route_type")
        tool.append("set_db cts_route_type_trunk shielded_clock_route_type")
    return True

