def cts_blackbox_fixes(tool: HammerTool) -> bool:
    if re.match(r"GINT2CHIMChipletTop", tool.top_module):
        array_name_prefix = "chim/fabric"
        tool.append("set_db pin:chim/fabric/clock .cts_sink_type stop")
        tool.append("foreach dc [get_db delay_corners .name] { set_db pin:chim/fabric/clock .cts_capacitance_override 0.01 -index \"delay_corner $dc \" }")
    elif re.match(r"GINT2[AB]ChipletTop", tool.top_module):
        array_name_prefix = "a"

        # print("entered bb_fixes hook")
        clock_pad_pins = "iocell_clock_io/PAD iocell_clock2_io/PAD"
        sdc_loads = tool.get_setting("vlsi.inputs.output_loads")
        array_sdc_loads = [name_load for name_load in sdc_loads]
        pin_name_groups = [f"{array_name_prefix}/{name_load['name']}" for name_load in array_sdc_loads]
        caps = [name_load["load"].split(" ")[0] for name_load in array_sdc_loads] # note: hook ignores units and assumes you used SDC cap unit (pF for GINT1)
        # tool.append("set_interactive_constraint_modes [all_constraint_modes]")
        for png, cap in zip(pin_name_groups, caps):
            tool.append(
                f"foreach pin [get_db [get_pins {png}] .name ] {{ set_db pin:$pin .cts_sink_type stop }}"
            )
            tool.append(
                f"foreach pin [get_db [get_pins {png}] .name ] {{ foreach dc [get_db delay_corners .name] {{set_db pin:$pin .cts_capacitance_override {cap} -index \"delay_corner $dc\" }} }}" 
            )
            # tool.append(
            #     f"set_max_capacitance {cap} [get_pins {png}]"
            # )
    elif tool.top_module == "GINT1AChipletTop":
        clock_pad_pins = "iocell_clock_io/PAD iocell_clock2_io/PAD"
        sdc_loads = tool.get_setting("vlsi.inputs.output_loads")
        array_sdc_loads = [name_load for name_load in sdc_loads]
        pin_name_groups = ["a/{n}".format(n=name_load["name"]) for name_load in array_sdc_loads]
        caps = [name_load["load"].split(" ")[0] for name_load in array_sdc_loads] # note: hook ignores units and assumes you used SDC cap unit (pF for GINT1)
        for png, cap in zip(pin_name_groups, caps):
            tool.append(
                f"foreach pin [get_db [get_pins {png}] .name ] {{ set_db pin:$pin .cts_sink_type stop }}"
            )
            tool.append(
                f"foreach pin [get_db [get_pins {png}] .name ] {{ foreach dc [get_db delay_corners .name] {{set_db pin:$pin .cts_capacitance_override {cap} -index \"delay_corner $dc\" }} }}" 
            )
        # tool.append("set_interactive_constraint_modes {}")

    return True

def write_spice_netlist(tool: HammerTool) -> bool:
    tool.append(
        f"write_netlist ./{tool.top_module}.spicesim.v -top_module {tool.top_module} -include_pg -exclude_leaf_cells -exclude_insts_of_cells {{ SPC_SP_010_33V SPC_SP_005_33V SPC_SP_001_33V SPC_SP_000_33V FILLTIE2_A12TR_W3 FILLTIE4_A12TR_W3 FILLTIE8_A12TR_W3 FILLTIE16_A12TR_W3 FILL1_A12TR_W3 FILL2_A12TR_W3 FILL4_A12TR_W3 FILL8_A12TR_W3 FILL16_A12TR_W3 FILL32_A12TR_W3 FILL64_A12TR_W3 FILL128_A12TR_W3 CNRCAPNWIN2_A12TR_W3 CNRCAPNWOUT2_A12TR_W3 INCNRCAPNWINTIE2_A12TR_W3 INCNRCAPNWOUTTIE2_A12TR_W3 TBCAPNWIN1_A12TR_W3 TBCAPNWOUT1_A12TR_W3 TBCAPNWIN128_A12TR_W3 TBCAPNWOUT128_A12TR_W3 }} " 
    )
    return True

def disable_undefined_blackbox_error(tool: HammerTool) -> bool:
    tool.append("set_db hdl_error_on_blackbox false")
    return True

def cts_blackbox_override(tool: HammerTool) -> bool:
    if "Top".upper() in tool.top_module.upper() and "CHIM".upper() in tool.top_module.upper():
        tool.append("set_db pin:chim/fabric/clock .cts_sink_type stop")
        tool.append("foreach dc [get_db delay_corners .name] { set_db pin:chim/fabric/clock .cts_capacitance_override 0.01 -index \"delay_corner $dc \" }")
    if re.match(r"GINT2[AB]ChipletTop", tool.top_module):
        pins_to_override = "a/PBIT_EN a/VSAF_EN a/VSAB_EN".split(" ")
        for pin in pins_to_override:
            tool.append(f"set_db pin:{pin} .cts_sink_type stop")
            tool.append(f"foreach dc [get_db delay_corners .name] {{ set_db pin:{pin} .cts_capacitance_override 0.01 -index \"delay_corner $dc \" }}")
    return True
    
